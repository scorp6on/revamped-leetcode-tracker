{
  "manifest_version": 3,
  "name": "lc/tracker sync",
  "version": "0.1.0",
  "description": "Sends your LeetCode submissions to your lc/tracker, from your own browser.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "lc/tracker sync"
  },
  "permissions": [
    "alarms",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://dcl5cus2cnbj3.cloudfront.net/*",
    "https://d22dgdygw10q10.cloudfront.net/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://dcl5cus2cnbj3.cloudfront.net/*",
      "https://d22dgdygw10q10.cloudfront.net/*"
    ]
  }
}
